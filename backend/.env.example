APP_ENV=development

API_PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_NAME=btmi_market
DB_USER=btmi_user
DB_PASSWORD=btmi_secret_password

JWT_SECRET=your-super-secret-jwt-key-change-in-production

ACCESS_TOKEN_TTL=15
REFRESH_TOKEN_TTL=10080

FRONTEND_URL=http://localhost:3000

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
BACKGROUND_WORKER_ENABLED=true
VISUAL_SEARCH_URL=http://visual-search:8090

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@btmi-market.com

# Shared secret a payment provider signs its webhooks with (HMAC-SHA256 over the
# raw body, sent as X-TBK-Signature: sha256=<hex>). Empty disables the webhook:
# no unsigned call can ever mark an order paid.
PAYMENT_WEBHOOK_SECRET=

# Moko Afrika mobile money (M-Pesa, Airtel, Orange, Afrimoney). Mobile money stays
# off while MOKO_MERCHANT_ID or MOKO_MERCHANT_SECRET is empty. The API logs at
# startup whether Moko accepted these credentials.
MOKO_BASE_URL=https://paydrc.gofreshbakery.net/api/v5
MOKO_MERCHANT_ID=
MOKO_MERCHANT_SECRET=
# Public URL of POST /api/v1/webhooks/moko, given to Moko on every request.
MOKO_CALLBACK_URL=
# Key for the callback X-Signature and its encryption (from Moko).
MOKO_CALLBACK_SECRET=
MOKO_PAYER_EMAIL=paiements@tbkmarket.com

# TomTom map tiles for the web live-tracking map, baked into the web build by
# docker compose. Empty = OpenFreeMap fallback. Restrict the key to our domains.
TOMTOM_API_KEY=

# WhatsApp sign-up / sign-in codes through an OpenWA gateway
# (https://github.com/rmyndharis/OpenWA, `docker compose --profile whatsapp up -d`).
# Empty: the WhatsApp choice is hidden (in development the code is only logged).
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=243

# WhatsApp Business Cloud API (Meta): the official channel, where a business
# opens a conversation with a template Meta approved beforehand. Empty token or
# phone number id keeps it off and no message is ever sent.
# Not yet wired to the sign-in codes, which still go through OPENWA_* above.
# When it is, the code has to travel on a template whose category is
# AUTHENTICATION: Meta refuses one-time codes on a UTILITY or MARKETING one,
# and approval takes up to a day, so file it before the switch.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version to call, and the language the templates are filed under.
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Sign-in codes by SMS, through Firebase Phone Auth.
# Firebase sends the message from the device and checks the code there, so no
# gateway and no secret are needed here: the server only verifies the ID token
# the app sends back, against Google's public certificates. The project id is
# what the token's issuer and audience are checked against — copy it from the
# Firebase console (Project settings > General > Project ID).
# Empty: /auth/sms/* answer SMS_UNAVAILABLE and the apps hide the SMS choice.
# The app side also needs @react-native-firebase/auth and a google-services.json,
# so Expo Go cannot offer SMS — only a development or production build can.
FIREBASE_PROJECT_ID=

# Push notifications (browser + Android app).
# Web push signs with a VAPID key pair. Leave VAPID_PRIVATE_KEY empty and one is
# generated on first start and stored in the database (table push_settings);
# set it only to pin a key across databases. Changing it invalidates every
# browser subscription (browsers re-subscribe on their next visit).
PUSH_ENABLED=true
PUSH_WEB_ENABLED=true
PUSH_EXPO_ENABLED=true
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tbkmarket.com
# Android push goes through Expo's push service: upload the Firebase (FCM v1)
# service account to the EAS project (eas credentials) and ship a build that
# contains google-services.json. Only needed if "enhanced push security" is on:
EXPO_ACCESS_TOKEN=
# Extra allowed browser push hosts, comma separated (tests / self-hosted).
PUSH_EXTRA_HOSTS=

# First-run setup of the single super admin account.
# While this holds a code that has never been claimed, the sign-in screen at
# /admin offers "create the super admin account": the owner enters this code,
# his own name, e-mail and password, and is signed in straight away. The code
# works once -- claiming it records a row in super_admin_setup_claims and the
# link disappears. Empty: no setup is offered and the account comes from the
# CLI bootstrap instead. Give the code to the owner over a separate channel.
SUPER_ADMIN_SETUP_CODE=
