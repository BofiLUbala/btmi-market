APP_ENV=development

API_PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_NAME=btmi_market
DB_USER=btmi_user
DB_PASSWORD=btmi_secret_password

JWT_SECRET=your-super-secret-jwt-key-change-in-production

ACCESS_TOKEN_TTL=15
REFRESH_TOKEN_TTL=10080

FRONTEND_URL=http://localhost:3000

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
BACKGROUND_WORKER_ENABLED=true
VISUAL_SEARCH_URL=http://visual-search:8090

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@btmi-market.com

# Shared secret a payment provider signs its webhooks with (HMAC-SHA256 over the
# raw body, sent as X-TBK-Signature: sha256=<hex>). Empty disables the webhook:
# no unsigned call can ever mark an order paid.
PAYMENT_WEBHOOK_SECRET=

# TomTom map tiles for the web live-tracking map, baked into the web build by
# docker compose. Empty = OpenFreeMap fallback. Restrict the key to our domains.
TOMTOM_API_KEY=

# WhatsApp sign-up / sign-in codes through an OpenWA gateway
# (https://github.com/rmyndharis/OpenWA, `docker compose --profile whatsapp up -d`).
# Empty: the WhatsApp choice is hidden (in development the code is only logged).
OPENWA_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
WHATSAPP_DEFAULT_COUNTRY_CODE=243

# Push notifications (browser + Android app).
# Web push signs with a VAPID key pair. Leave VAPID_PRIVATE_KEY empty and one is
# generated on first start and stored in the database (table push_settings);
# set it only to pin a key across databases. Changing it invalidates every
# browser subscription (browsers re-subscribe on their next visit).
PUSH_ENABLED=true
PUSH_WEB_ENABLED=true
PUSH_EXPO_ENABLED=true
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tbkmarket.com
# Android push goes through Expo's push service: upload the Firebase (FCM v1)
# service account to the EAS project (eas credentials) and ship a build that
# contains google-services.json. Only needed if "enhanced push security" is on:
EXPO_ACCESS_TOKEN=
# Extra allowed browser push hosts, comma separated (tests / self-hosted).
PUSH_EXTRA_HOSTS=
