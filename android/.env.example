# Local development on a physical device or emulator.
# Leave this file's value unset to let the app derive the Metro host
# automatically (works for a phone on the same Wi-Fi). Set it explicitly only
# to override that discovery.
#
#   EXPO_PUBLIC_API_URL=http://<YOUR-LAN-IP>:8080/api/v1
#
# Preview / external beta (EAS build): supply the public HTTPS URL at build
# time, never commit it. Must end with /api/v1.
#
#   EXPO_PUBLIC_API_URL=https://<beta-api-host>/api/v1
#
# Production: set as an EAS environment variable.
EXPO_PUBLIC_API_URL=
